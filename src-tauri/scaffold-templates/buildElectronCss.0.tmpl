:root {
  color-scheme: dark;
  font-family: Inter, "SF Pro Display", system-ui, sans-serif;
}

body {
  margin: 0;
  min-height: 100vh;
  background: #141414;
  color: #f5f5f5;
}

.shell {
  display: grid;
  min-height: 100vh;
  place-items: center;
  padding: 32px;
}

.hero {
  width: min(820px, 100%);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 20px;
  background: rgba(255, 255, 255, 0.04);
  padding: 32px;
}

.eyebrow {
  margin: 0 0 8px;
  color: #f59e0b;
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

h1 {
  margin: 0;
  font-size: 40px;
}

.summary {
  color: #cbd5e1;
  line-height: 1.6;
}

.list {
  margin: 20px 0 0;
  padding-left: 18px;
  color: #e2e8f0;
  line-height: 1.8;
}

.chip {
  display: inline-flex;
  margin-top: 20px;
  border: 1px solid rgba(245, 158, 11, 0.35);
  border-radius: 999px;
  padding: 8px 12px;
  color: #fbbf24;
  font-size: 13px;
}
