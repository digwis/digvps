package main

import (
	"encoding/json"
	"log"
	"net/http"
)

func main() {
	http.HandleFunc("/health", func(w http.ResponseWriter, _ *http.Request) {
		_ = json.NewEncoder(w).Encode(map[string]any{
			"ok": true,
			"service": "go-worker",
			"project": "${slug}",
		})
	})

	log.Println("go-worker listening on :8200")
	log.Fatal(http.ListenAndServe(":8200", nil))
}
