{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DigVPS",
  "version": "1.0.0",
  "identifier": "com.digwis.openvps",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "DigVPS",
        "width": 1440,
        "height": 920,
        "minWidth": 1120,
        "minHeight": 720,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "backgroundColor": "#0d0f14",
        "trafficLightPosition": { "x": 16, "y": 16 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ws: http: https: tauri: ipc: http://ipc.localhost;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "12.0"
    }
  }
}
